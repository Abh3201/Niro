# Settings for `docker compose`. Copy to .env and fill in.

# Signs share links; both servers need the same one. Required, 32+ characters.
# Make one with: openssl rand -hex 32
NIRO_SECRET=

# Change for any deployment that isn't on your own machine.
# POSTGRES_PASSWORD=niro

# Where browsers open the realtime WebSocket. Defaults to the web app's host
# on port 8787; set it behind a reverse proxy or if you change REALTIME_PORT.
# PUBLIC_REALTIME_URL=wss://realtime.example.com

# Accounts: sign in with Google or an emailed link, and a list of your
# boards. Off until one way to sign in is set up. Steps: docs/accounts.md.
# The address people open Niro at (compose.https.yml sets it from NIRO_DOMAIN).
# PUBLIC_URL=http://localhost:3000
# Google: a Web OAuth client, redirect URI <PUBLIC_URL>/api/auth/callback/google.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Email, with Resend (resend.com). EMAIL_FROM must be on a domain verified there.
# RESEND_API_KEY=
# EMAIL_FROM=Niro <signin@example.com>
# Who runs this site and how to reach them, for /privacy and /terms.
# Google's OAuth consent screen links those pages.
# NIRO_OPERATOR=Ada Lovelace
# NIRO_CONTACT_EMAIL=privacy@example.com

# Require this token to read the realtime server's /metrics
# (Authorization: Bearer <token>). Set it when port 8787 is public.
# METRICS_TOKEN=

# Limits, with their defaults. A board past one turns read-only.
# NIRO_MAX_SHAPES=10000
# NIRO_MAX_BOARD_MB=5
# NIRO_MAX_CONNECTIONS_PER_BOARD=100

# Images: largest file, and all of one board's images together, in MB.
# NIRO_MAX_IMAGE_MB=5
# NIRO_MAX_BOARD_IMAGES_MB=50
# NIRO_MAX_VERSIONS=30
# NIRO_MAX_BOARD_VERSIONS_MB=25

# Limits for the whole realtime server: its memory budget, as MB of open
# boards (each takes about 25 times its size in memory, so 40 is about 1 GB),
# and connections. Past either, newcomers are turned away until some leave.
# NIRO_MAX_OPEN_MB=40
# NIRO_MAX_CONNECTIONS=2000

# Your domain, for HTTPS with compose.https.yml (docs/self-hosting.md).
# NIRO_DOMAIN=board.example.com
