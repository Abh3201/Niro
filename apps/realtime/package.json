{
  "name": "@niro/realtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Realtime WebSocket server: rooms, sync, presence and persistence.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --sourcemap --outfile=dist/index.js --external:ws --external:yjs --external:y-protocols --external:lib0 --external:pg",
    "start": "node dist/index.js",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "lib0": "^0.2.119",
    "pg": "^8.23.1",
    "ws": "^8.22.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@niro/doc": "workspace:*",
    "@niro/sync": "workspace:*",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
